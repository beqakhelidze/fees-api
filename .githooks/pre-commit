#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

echo "pre-commit: gofmt -w fees"
gofmt -w fees

# Re-stage any already-staged Go files that gofmt changed.
staged_go="$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)"
if [[ -n "$staged_go" ]]; then
  # shellcheck disable=SC2086
  echo "$staged_go" | tr '\n' '\0' | xargs -0 git add --
fi

echo "pre-commit: go test ./fees/domain/ ./fees/workflows/"
go test ./fees/domain/ ./fees/workflows/

echo "pre-commit: ok"
